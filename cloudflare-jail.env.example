# Copy to /etc/cloudflare-jail.env on the Apache host.
#   sudo install -m 600 -o root -g root cloudflare-jail.env.example /etc/cloudflare-jail.env
# Do not commit the real file. Rotate any keys that were previously in parse_logs.sh.txt.

ABUSEIPDB_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Must match the list name in the BLOCK_BOTS expression: ip.src in $jail_list
CLOUDFLARE_LIST_NAME=jail_list

# Optional. Leave blank and the script will look the list up by name.
# CLOUDFLARE_LIST_ID=

# Optional. Override default thresholds.
# HIT_THRESHOLD=250
# PROBE_THRESHOLD=10
# SCORE_JAIL=50
# SCORE_SUBNET=75
# SCORE_GB_HOSTING=75
# CACHE_TTL_DAYS=7

# Optional email. Leave EMAIL_RECIPIENT blank to disable.
EMAIL_RECIPIENT=
EMAIL_FROM=Cloudflare WAF Engine <security@cloudsentis.com>
